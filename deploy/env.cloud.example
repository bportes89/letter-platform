# ============================================================
# Variáveis para colar nos painéis (demo gratuito)
# Substitua os placeholders antes de publicar.
# ============================================================

# ---------- Neon (Postgres) ----------
# Dashboard Neon > Connection string > URI (com sslmode=require)
# Exemplo: postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
# Cole isso em LETTER_DATABASE_URL no Render (a API normaliza para psycopg3).


# ---------- Render (API) ----------
LETTER_ENV=staging
LETTER_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
LETTER_SECRET_KEY=gere-uma-chave-com-pelo-menos-32-caracteres-aleatorios
LETTER_DEMO_PASSWORD=TroqueEstaSenha@Demo2026
LETTER_CORS_ORIGINS=https://SEU-APP.vercel.app
LETTER_FINANCIAL_TRANSACTIONS_ENABLED=false
LETTER_STORAGE_BACKEND=LOCAL
LETTER_STORAGE_PATH=./storage
LETTER_LOG_LEVEL=INFO
LETTER_ACCESS_TOKEN_MINUTES=30
LETTER_REFRESH_TOKEN_DAYS=7
LETTER_PUBLIC_RATE_LIMIT_PER_MINUTE=300
LETTER_LOGIN_RATE_LIMIT_PER_MINUTE=20
# Com OTP ativo, configure Resend ou SMTP abaixo — contas demo (@letter.com.br) não têm caixa de entrada.
LETTER_LOGIN_EMAIL_OTP=true
# Opcional: protege POST /api/v1/system/cron/* (inclui marketplace-quota-sync)
LETTER_CRON_SECRET=

# Masters comerciais (raiz das árvores LETTER_BANK e RMK_BEVI)
# Confirmar com o Paulo antes de publicar — sugestões do export legado abaixo.
# LETTER_MASTER_LETTER_BANK_EMAIL=comercial@letter.app.br
# LETTER_MASTER_RMK_BEVI_EMAIL=senhas.icred@bevioficial.com.br

# Asaas — credenciais fornecidas pelo cliente (NUNCA commitar valores reais)
# Chave $aact_prod_* = produção → https://api.asaas.com/v3
# Chave $aact_hmlg_* = sandbox  → https://api-sandbox.asaas.com/v3
LETTER_ASAAS_API_KEY=
LETTER_ASAAS_WALLET_ID=
LETTER_ASAAS_BASE_URL=https://api.asaas.com/v3
LETTER_ASAAS_ESCROW_ENABLED=true
LETTER_ASAAS_ESCROW_DAYS_TO_EXPIRE=10
LETTER_ASAAS_ESCROW_FEE_PAYER_SUBACCOUNT=false
LETTER_ASAAS_SUBACCOUNT_DEFAULT_MOBILE_PHONE=71999999999
LETTER_ASAAS_SUBACCOUNT_DEFAULT_INCOME_VALUE=50000
LETTER_ASAAS_SUBACCOUNT_DEFAULT_ADDRESS=Av. Tancredo Neves
LETTER_ASAAS_SUBACCOUNT_DEFAULT_ADDRESS_NUMBER=620
LETTER_ASAAS_SUBACCOUNT_DEFAULT_PROVINCE=Caminho das Arvores
LETTER_ASAAS_SUBACCOUNT_DEFAULT_POSTAL_CODE=41820020

# ZapSign — token em Configurações > Integrações > API ZAPSIGN (NUNCA commitar valor real)
# Sandbox: https://sandbox.api.zapsign.com.br/api/v1
LETTER_ZAPSIGN_API_TOKEN=
LETTER_ZAPSIGN_BASE_URL=https://api.zapsign.com.br/api/v1
LETTER_ZAPSIGN_AUTH_MODE=assinaturaTela-tokenEmail
LETTER_ZAPSIGN_SEND_AUTOMATIC_EMAIL=true
LETTER_ZAPSIGN_LANG=pt-br

# E-mail transacional (convites admin, LETTER BANK) — sem isso o sistema só gera o link
# Resend (recomendado): domínio plataformaletter.com.br verificado no painel Resend
# LETTER_RESEND_API_KEY=re_xxxxxxxx
# LETTER_SMTP_FROM_EMAIL=comercial@letter.app.br
# LETTER_SMTP_FROM_NAME=LETTER Platform
#
# Alternativa SMTP (Office 365 / Google):
# LETTER_SMTP_HOST=smtp.office365.com
# LETTER_SMTP_PORT=587
# LETTER_SMTP_USER=comercial@letter.app.br
# LETTER_SMTP_PASSWORD=
# LETTER_SMTP_USE_TLS=true


# ---------- Vercel (Frontend) ----------
# Root Directory: frontend
NEXT_PUBLIC_API_URL=https://letter-api-XXXX.onrender.com/api/v1
