[Unit]
Description=LETTER Platform API
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/letter-platform/backend
EnvironmentFile=/etc/letter-platform/api.env
ExecStart=/opt/letter-platform/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=always
RestartSec=5
User=letter
Group=letter
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
