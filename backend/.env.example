LETTER_ENV=development
LETTER_DATABASE_URL=sqlite:///./letter.db
LETTER_SECRET_KEY=change-me-with-at-least-32-random-characters
LETTER_ACCESS_TOKEN_MINUTES=30
LETTER_REFRESH_TOKEN_DAYS=7
LETTER_CORS_ORIGINS=http://localhost:3000
LETTER_FINANCIAL_TRANSACTIONS_ENABLED=false
LETTER_STORAGE_PATH=./storage
LETTER_STORAGE_BACKEND=LOCAL
LETTER_S3_BUCKET=
LETTER_S3_REGION=sa-east-1
LETTER_S3_ENDPOINT_URL=
LETTER_MAX_UPLOAD_MB=10
LETTER_LOG_LEVEL=INFO
LETTER_WORKER_POLL_SECONDS=5
LETTER_WORKER_BATCH_SIZE=20
LETTER_PUBLIC_RATE_LIMIT_PER_MINUTE=300
LETTER_LOGIN_RATE_LIMIT_PER_MINUTE=20
LETTER_INTEGRATION_CIRCUIT_FAILURE_THRESHOLD=3
LETTER_INTEGRATION_CIRCUIT_COOLDOWN_SECONDS=60
LETTER_INTEGRATION_HTTP_TIMEOUT_SECONDS=10

# ---------- Asaas (Escrow / BaaS) ----------
# Sandbox: https://api-sandbox.asaas.com/v3
# Produção: https://api.asaas.com/v3
LETTER_ASAAS_API_KEY=
LETTER_ASAAS_WALLET_ID=
LETTER_ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
LETTER_ASAAS_ESCROW_ENABLED=true
LETTER_ASAAS_ESCROW_DAYS_TO_EXPIRE=10
LETTER_ASAAS_ESCROW_FEE_PAYER_SUBACCOUNT=false
# Defaults usados ao abrir subconta Escrow em 1 clique (quando operação/org não informam endereço)
LETTER_ASAAS_SUBACCOUNT_DEFAULT_MOBILE_PHONE=71999999999
LETTER_ASAAS_SUBACCOUNT_DEFAULT_INCOME_VALUE=50000
LETTER_ASAAS_SUBACCOUNT_DEFAULT_ADDRESS=Av. Tancredo Neves
LETTER_ASAAS_SUBACCOUNT_DEFAULT_ADDRESS_NUMBER=620
LETTER_ASAAS_SUBACCOUNT_DEFAULT_PROVINCE=Caminho das Arvores
LETTER_ASAAS_SUBACCOUNT_DEFAULT_POSTAL_CODE=41820020
LETTER_ASAAS_WEBHOOK_ACCESS_TOKEN=
LETTER_AUTO_PLAIN_SUBACCOUNT_ON_KYC=true
LETTER_AUTO_CREDIT_COMMISSION_TO_PARTNER_WALLET=true
# Mensalidade Escrow (somente contas com Escrow) e taxas por transação (todas as contas)
LETTER_WALLET_ESCROW_MONTHLY_FEE=499.90
LETTER_WALLET_FEE_PIX=1.99
LETTER_WALLET_FEE_BOLETO=3.49
LETTER_WALLET_FEE_CARD_PERCENT=3.99
LETTER_WALLET_FEE_CARD_FIXED=0.40
LETTER_WALLET_FEE_TRANSFER=4.90
LETTER_WALLET_FEE_BILL_PAYMENT=0
LETTER_WALLET_BILLING_CYCLE_DAYS=30
LETTER_WALLET_ESCROW_BILLING_ENABLED=true

# ---------- ZapSign (assinatura eletrônica) ----------
# Sandbox: https://sandbox.api.zapsign.com.br/api/v1
# Produção: https://api.zapsign.com.br/api/v1
LETTER_ZAPSIGN_API_TOKEN=
LETTER_ZAPSIGN_BASE_URL=https://api.zapsign.com.br/api/v1
LETTER_ZAPSIGN_AUTH_MODE=assinaturaTela-tokenEmail
LETTER_ZAPSIGN_SEND_AUTOMATIC_EMAIL=true
LETTER_ZAPSIGN_LANG=pt-br

# ---------- Inventário infra TAPAF (NINA v4.0) — preencher após homologação ----------
LETTER_ONR_CLIENT_ID=
LETTER_ONR_CLIENT_SECRET=
LETTER_DATAZAP_API_TOKEN=
LETTER_SERASA_API_KEY=
LETTER_JUDIS_API_KEY=
# Robô fiscal comissões — consulta NF-e real na SEFAZ (InfoSimples)
LETTER_INFOSIMPLES_API_TOKEN=
LETTER_SERPRO_API_KEY=
LETTER_FIPE_API_TOKEN=
LETTER_FIPE_PLATE_API_BASE_URL=https://placas.fipeapi.com.br
LETTER_MOLICAR_API_TOKEN=
LETTER_INCRA_API_KEY=
# Bacen SCR / Registrato (consulta produtiva após credenciamento)
LETTER_BACEN_SCR_API_URL=
LETTER_BACEN_SCR_INSTITUTION_CODE=
LETTER_BACEN_SCR_API_KEY=
LETTER_BACEN_ADMIN_RULES_SYNC_HOURS=24
# Cron Render: POST /api/v1/system/cron/nina-bacen-admin-rules-sync (header X-Cron-Secret)
# Cron Render: POST /api/v1/system/cron/wallet-escrow-billing (header X-Cron-Secret)
# Cron Render: POST /api/v1/system/cron/lss-billing-evaluation (header X-Cron-Secret)
LETTER_LSS_BILLING_ENABLED=true
LETTER_LSS_DEFAULT_BILLING_TYPE=BOLETO
LETTER_CRON_SECRET=

