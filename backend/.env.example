LETTER_ENV=development
LETTER_DATABASE_URL=sqlite:///./letter.db
LETTER_SECRET_KEY=change-me-with-at-least-32-random-characters
LETTER_ACCESS_TOKEN_MINUTES=30
LETTER_REFRESH_TOKEN_DAYS=7
# Local: lista JSON ou CSV. Cloud: veja deploy/env.cloud.example
LETTER_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LETTER_DEMO_PASSWORD=Letter@123
LETTER_FINANCIAL_TRANSACTIONS_ENABLED=false
LETTER_STORAGE_PATH=./storage
LETTER_STORAGE_BACKEND=LOCAL
LETTER_S3_BUCKET=
LETTER_S3_REGION=sa-east-1
LETTER_S3_ENDPOINT_URL=
LETTER_MAX_UPLOAD_MB=10
LETTER_LOG_LEVEL=INFO
LETTER_WORKER_POLL_SECONDS=5
LETTER_WORKER_BATCH_SIZE=20
LETTER_PUBLIC_RATE_LIMIT_PER_MINUTE=300
LETTER_LOGIN_RATE_LIMIT_PER_MINUTE=20
LETTER_INTEGRATION_CIRCUIT_FAILURE_THRESHOLD=3
LETTER_INTEGRATION_CIRCUIT_COOLDOWN_SECONDS=60
LETTER_INTEGRATION_HTTP_TIMEOUT_SECONDS=10
